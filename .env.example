# Auth: this project uses Claude Pro/Max subscription via the Claude Code CLI.
# Run `claude login` once to authenticate — credentials are stored in ~/.claude/.
# Do NOT set ANTHROPIC_API_KEY here; the script unsets it to force subscription auth.

# Garmin Connect Personal API key.
# Put the real value in your local .env file, never in this example or Git.
GARMIN_PERSONAL_API_KEY=

# Local API authentication configuration.
GCP_PROJECT_ID=
ALLOWED_USER_EMAIL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Legacy V0 only: path to the local SQLite database produced by garmin-health-data.
# Leave empty unless you still use the old training-coach CLI.
GARMIN_DB_PATH=
