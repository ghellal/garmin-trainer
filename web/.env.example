# Public Firebase web-app config (not a server credential).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Use http://localhost:8080 for local API development; leave blank on Firebase Hosting
# to use the same-origin /api rewrite.
VITE_API_BASE_URL=http://localhost:8080
